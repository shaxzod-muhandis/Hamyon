{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(transactions|accounts|debts|budget|plan|analytics|reminders|settings)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "{src,migrations,public}/**", "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/tick", "schedule": "0 3 * * *" }]
}
