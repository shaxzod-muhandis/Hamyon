{
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "{src,migrations}/**", "maxDuration": 30 }
  },
  "crons": [{ "path": "/api/cron/tick", "schedule": "0 3 * * *" }]
}
