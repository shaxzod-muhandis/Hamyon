# Barcha qiymatlar placeholder. Haqiqiy kalitlarni FAQAT .env.local / Vercel'da saqlang.
# Supabase → Connect → Transaction pooler (6543). Prisma'ga xos `?pgbouncer=true` KERAK EMAS.
DATABASE_URL=postgresql://postgres.<loyiha-id>:PAROL@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migratsiya uchun (ixtiyoriy): Session pooler (5432)
DIRECT_URL=postgresql://postgres.<loyiha-id>:PAROL@aws-0-<region>.pooler.supabase.com:5432/postgres
# Test bazasi — alohida, bo'sh baza (testlar yozuv yaratadi)
TEST_DATABASE_URL=
# @BotFather bergan token
BOT_TOKEN=
# setWebhook'ga beriladigan maxfiy so'z (istalgan uzun tasodifiy satr)
WEBHOOK_SECRET=
# Cron va /api/admin/* uchun maxfiy kalit
CRON_SECRET=
# Vercel manzili, oxirida "/" siz: https://hamyon.vercel.app
APP_URL=
# Bot username (@siz): hamyon_bot
BOT_USERNAME=
# Mini App tayyor bo'lgach 1 qiling (menyu tugmasi va "Ilova" tugmasi paydo bo'ladi)
WEBAPP_ENABLED=0
